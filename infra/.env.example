AWS_REGION=us-east-1
AWS_PROFILE=default

EKS_CLUSTER_NAME=store-platform
EKS_VERSION=1.30
EKS_NODE_INSTANCE_TYPE=t3.small
EKS_NODE_DESIRED_CAPACITY=2
EKS_NODE_MIN_SIZE=1
EKS_NODE_MAX_SIZE=4
EKS_NODE_VOLUME_SIZE=20

RDS_INSTANCE_ID=store-platform-db
RDS_DB_NAME=store
RDS_USERNAME=store
RDS_PASSWORD=change-me

# Use postgres for the in-cluster database, or paste the RDS endpoint after creating it.
DATABASE_HOST=postgres

DOCKERHUB_NAMESPACE=your-dockerhub-user
K8S_NAMESPACE=store-platform

# The service repositories are siblings of micro_api_26.1 in this workspace.
SERVICE_ROOT=..
