# Copie este arquivo para infra/.env e preencha os valores reais.
# Nunca commite infra/.env.

# AWS
AWS_REGION=us-east-1
AWS_PROFILE=default

# EKS
EKS_CLUSTER_NAME=store-platform

# RDS PostgreSQL
RDS_INSTANCE_ID=store-platform-db
RDS_DB_NAME=store
RDS_USERNAME=store
RDS_PASSWORD=troque-esta-senha

# Docker Hub
DOCKERHUB_NAMESPACE=seu-usuario-dockerhub

# Kubernetes
K8S_NAMESPACE=store-platform

