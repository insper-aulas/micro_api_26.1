# Copie este arquivo para infra/.env e preencha os valores reais.
# Nunca commite infra/.env.

# AWS
AWS_REGION=us-east-1
AWS_PROFILE=default

# EKS
EKS_CLUSTER_NAME=store-platform
EKS_VERSION=1.30
EKS_NODE_INSTANCE_TYPE=t3.small
EKS_NODE_DESIRED_CAPACITY=2
EKS_NODE_MIN_SIZE=1
EKS_NODE_MAX_SIZE=4
EKS_NODE_VOLUME_SIZE=20

# RDS PostgreSQL
RDS_INSTANCE_ID=store-platform-db
RDS_DB_NAME=store
RDS_USERNAME=store
RDS_PASSWORD=troque-esta-senha

# Use postgres para banco dentro do cluster.
# Depois de criar o RDS, troque pelo endpoint retornado pelo script.
DATABASE_HOST=postgres

# Docker Hub
DOCKERHUB_NAMESPACE=seu-usuario-dockerhub

# Kubernetes
K8S_NAMESPACE=store-platform

# Os repositorios dos servicos ficam como irmaos do micro_api_26.1.
SERVICE_ROOT=..
